{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src", "scripts", "vite.config.ts", "drizzle.config.ts"]
}
