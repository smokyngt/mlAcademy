 },
 {
  "id": "f2n.12.c16",
  "concept": "nn.autograd",
  "front": "`.detach()`",
  "back": "Returns a tensor cut from the graph; gradients do not flow through."
 },
 {
  "id": "f2n.12.c17",
  "concept": "nn.autograd",
  "front": "Gradient accumulation in PyTorch",
  "back": "`backward()` adds to `.grad`; call `zero_grad()` each step."
 },
 {
  "id": "f2n.12.c18",
  "concept": "nn.autograd",
  "front": "Forward mode cost",
  "back": "One pass per input (a Jacobian column)."
 },
 {
  "id": "f2n.12.c19",
  "concept": "nn.autograd",
  "front": "Reverse mode cost",
  "back": "One pass per output (a Jacobian row)."
 },
 {
  "id": "f2n.12.c20",
  "concept": "nn.autograd",
  "front": "Memory cost of reverse mode",
  "back": "Must store forward activations needed by local derivatives."
 },
 {
  "id": "f2n.12.c21",
  "concept": "nn.autograd",
  "front": "Local rule for $c=\\tanh a$",
  "back": "$\\bar a\\mathrel{+}=(1-c^2)\\bar c$."
 },
 {
  "id": "f2n.12.c22",
  "concept": "nn.autograd",
  "front": "Local rule for $c=a^p$",
  "back": "$\\bar a\\mathrel{+}=p\\,a^{p-1}\\bar c$."
 },
