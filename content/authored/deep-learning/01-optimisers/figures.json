  {
    "id": "warmup-cosine",
    "after": 5,
    "kind": "plot",
    "caption": {
      "en": "The warmup plus cosine-decay schedule, with eta_max = 1 (normalised), eta_min = 0.01, W = 100 warmup steps and T = 1000 total steps: linear ramp up, then half a cosine down.",
      "fr": "Le planning warmup plus décroissance cosinus, avec eta_max = 1 (normalisé), eta_min = 0,01, W = 100 pas de warmup et T = 1000 pas au total : montée linéaire, puis un demi-cosinus de descente."
    },
    "spec": {
      "xDomain": [
        0,
        1000
      ],
      "yDomain": [
        0,
        1.1
      ],
      "height": 300,
      "title": "eta(t) / eta_max",
      "data": [
        {
          "fn": "x/100",
          "range": [
            0,
            100
          ],
          "color": "#16a34a"
        },
        {
          "fn": "0.01 + 0.495*(1 + cos(3.14159265*(x - 100)/900))",
