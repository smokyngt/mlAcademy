[
 {
  "id": "mx.05.c1",
  "concept": "mx.integral",
  "front": "Riemann sum",
  "back": "$S_n=\\sum f(x_k)h$; the definite integral is its limit as $n\\to\\infty$."
 },
 {
  "id": "mx.05.c2",
  "concept": "mx.integral",
  "front": "Fundamental theorem of calculus",
  "back": "$\\frac{d}{dx}\\int_a^xf=f(x)$ and $\\int_a^bf=G(b)-G(a)$ for any antiderivative $G$."
 },
 {
  "id": "mx.05.c3",
  "concept": "mx.integral",
  "front": "Substitution",
  "back": "Chain rule backwards: $\\int f(g(x))g'(x)dx=\\int f(u)du$ with $u=g(x)$."
 },
 {
  "id": "mx.05.c4",
  "concept": "mx.integral",
  "front": "Integration by parts",
  "back": "$\\int uv'=[uv]-\\int u'v$ (product rule backwards)."
 },
 {
  "id": "mx.05.c5",
  "concept": "mx.expect-integral",
  "front": "Probability density function",
  "back": "$p\\ge0$, $\\int p=1$, $P(a\\le X\\le b)=\\int_a^bp$; may exceed 1 in height."
 },
 {
  "id": "mx.05.c6",
  "concept": "mx.expect-integral",
  "front": "Expectation as an integral",
  "back": "$\\mathbb{E}[g(X)]=\\int g(x)p(x)dx$; variance is $\\mathbb{E}[X^2]-(\\mathbb{E}X)^2$."
 },
 {
  "id": "mx.05.c7",
  "concept": "mx.expect-integral",
  "front": "Marginal of a joint density",
  "back": "$p(x)=\\int p(x,y)dy$: integrate the other variables out."
 },
 {
  "id": "mx.05.c8",
  "concept": "mx.expect-integral",
  "front": "Gaussian integral",
  "back": "$\\int_{-\\infty}^\\infty e^{-x^2/2}dx=\\sqrt{2\\pi}$ (square it, polar coordinates)."
 },
 {
  "id": "mx.05.c9",
  "concept": "mx.expect-integral",
  "front": "Polar area element",
  "back": "$dx\\,dy=r\\,dr\\,d\\theta$: the extra $r$ is the Jacobian."
 },
 {
  "id": "mx.05.c10",
  "concept": "mx.numint",
  "front": "Trapezoid rule",
  "back": "$h(\\frac12y_0+y_1+\\dots+y_{n-1}+\\frac12y_n)$; error $O(h^2)$."
 },
 {
  "id": "mx.05.c11",
  "concept": "mx.numint",
  "front": "Simpson's rule",
  "back": "$\\frac h3(y_0+4y_1+2y_2+\\dots+4y_{n-1}+y_n)$, $n$ even; error $O(h^4)$; exact for cubics."
 },
 {
  "id": "mx.05.c12",
  "concept": "mx.numint",
  "front": "Monte Carlo integration",
  "back": "$\\int_a^bf\\approx\\frac{b-a}n\\sum f(u_i)$ with uniform $u_i$; error $\\sigma/\\sqrt n$."
 },
 {
  "id": "mx.05.c13",
  "concept": "mx.numint",
  "front": "Curse of dimensionality for grids",
  "back": "A grid with $m$ points per axis needs $m^d$ evaluations; Monte Carlo's $n^{-1/2}$ rate is dimension-free."
 },
 {
  "id": "mx.05.c14",
  "concept": "mx.numint",
  "front": "Mini-batch training as Monte Carlo",
  "back": "The average loss over a random batch is a Monte Carlo estimate of the expected loss integral."
 }
]