  "platform": [
    {
      "area": "Verification",
      "item": "The web UI has never been looked at in a real browser by the author of this code. Layout, colours and interactions are untested visually; typecheck, build, API tests, server-side rendering tests and a module-load crawl were run.",
      "severity": "high"
    },
    {
      "area": "Execution",
      "item": "The Docker (PyTorch) runner has never run end to end: the Docker daemon was off. The PyTorch exercises were verified with a local Python instead.",
      "severity": "high"
    },
    {
      "area": "Language",
      "item": "Interface strings exist in French and English and the server can serve translated lessons, quizzes and cards, but no course text is translated yet: all lessons, quizzes, flashcards and exercise statements are English only.",
      "severity": "high"
    },
    {
      "area": "Sources",
      "item": "The 17 first lessons (functions through PCA) were written from general knowledge; their library citations are pointers. They have not yet been re-checked against the sources. Later lessons were written after reading the cited pages or files, often only the opening sections of repo lessons: each lesson's source list says which.",
      "severity": "medium"
    },
    {
      "area": "Sources",
      "item": "Several figures in the library's own lessons disagreed with their code or with arithmetic (examples found: a CNN parameter count, a codec bitrate, a scaling-law ratio, an FID bias claim). Where an author noticed, the lesson says so; others may remain.",
      "severity": "medium"
    },
    {
      "area": "Content",
      "item": "Lessons rely on exercises that ran in a local Python. They have not been timed inside the browser WebAssembly runtime; the heaviest (CTC, Griffin-Lim, Gibbs, DQN loops) may be slow there.",
      "severity": "medium"
    },
    {
      "area": "Pedagogy",
      "item": "Mastery weights (quiz 0.3, exercise 0.5, card 0.15) and thresholds are reasonable heuristics, not calibrated. No adaptive difficulty, no spaced practice of exercises.",
      "severity": "medium"
    },
    {
      "area": "Lab",
      "item": "Notebook cells are plain text areas: no plotting (matplotlib is not available in the runtime), no syntax highlighting, no autocompletion. Projects as long multi-stage notebooks are not built yet.",
      "severity": "medium"
    },
    {
      "area": "Security",
      "item": "Results from the browser runtime are reported by the client and trusted by the server: fine for one local user, not for a shared deployment. No authentication.",
      "severity": "medium"
    },
    {
      "area": "Data",
      "item": "No export/import or backup of progress (it lives in data/academy.db).",
      "severity": "low"
    },
    {
      "area": "Accessibility",
      "item": "Labels and roles were added but no accessibility audit (contrast, keyboard paths, screen reader) was run.",
      "severity": "low"
    },
    {
      "area": "Capstone",
      "item": "One capstone only, self-assessed. Nothing grades the written evidence.",
      "severity": "low"
    }
  ]
}